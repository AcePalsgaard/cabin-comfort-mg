<?xml version="1.0" encoding="utf-8"?>
<!-- The login is encrypted with a Keystore key that never leaves the phone,
     so a restored copy could not be decrypted. Keep it out of backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
